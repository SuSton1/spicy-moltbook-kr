{
  "kind": "tp12_selector_feature_source_repair_contract_v1",
  "patchKey": "tp12_selector_feature_source_repair_v1",
  "goal": {
    "target": "Improve same-day selector quality for operational TP12 recommendations.",
    "minimumMonthlyRecommendations": 5,
    "operationalTargetPct": 0.12,
    "selectionProblem": "Candidate supply is not the bottleneck; the selector must choose the better symbol inside the same decision date."
  },
  "sourceTiming": {
    "allowedAsOf": "D0_CLOSE_ONLY",
    "entryPolicyAwareness": "D+1 open and execution fields are labels/audit fields only, never selector features."
  },
  "requiredSources": [
    {
      "sourceId": "dailyCandleD0",
      "required": true,
      "cutoff": "D0_CLOSE",
      "coverage": "fail_fast_required_symbol_date"
    },
    {
      "sourceId": "sideDailyD0",
      "required": true,
      "gateId": "d0_close",
      "cutoff": "D0_CLOSE",
      "coverage": "fail_fast_required_symbol_date"
    },
    {
      "sourceId": "intradayD0Close",
      "required": true,
      "gateId": "d0_close",
      "cutoff": "D0_CLOSE",
      "coverage": "fail_fast_required_symbol_date"
    }
  ],
  "requiredBaseFields": [
    "openToCloseReturn",
    "tradedValue",
    "tradedValueRel20",
    "closeLocation",
    "rangePct"
  ],
  "requiredSideFeatureFields": [
    "side_alignment_investor_program_d0_sign",
    "side_pressure_investor_program_d0_signed_log1p",
    "investor_d0_signed_log1p",
    "program_d0_signed_log1p"
  ],
  "requiredIntradayFeatureFields": [
    "d0_close_strength",
    "d0_close_strength_after_breakout",
    "d0_vwap_hold_ratio"
  ],
  "requiredSelectorFeatureFields": [
    "d0ClosePressurePct",
    "d0TradingValue",
    "d0TradingValueRel20",
    "d0CloseLocation",
    "d0RangePct",
    "d0SideDailyAlignment",
    "d0SideDailyPressure",
    "d0IntradayCloseStrength",
    "d0IntradayVwapHoldRatio"
  ],
  "forbiddenFeatureFields": [
    "entryOpen",
    "entryGapPct",
    "entryVolume",
    "entryDateKey",
    "hitDateKey",
    "futureHigh",
    "futureLow",
    "maxForwardReturn",
    "minForwardReturn",
    "maxForwardHighPct",
    "minForwardLowPct",
    "forwardMaxReturn",
    "forwardMinReturn",
    "d1Open",
    "nextOpen",
    "nextSessionOpen"
  ],
  "forbiddenFeatureFieldPatterns": [
    "(^|[._-])d1[_-]?open",
    "d\\+1",
    "next[_-]?open",
    "future",
    "forward",
    "hitDate",
    "entry(Open|Gap|Volume)"
  ],
  "guardrails": {
    "missingValueZeroFillAllowed": false,
    "renameOnlyRankerRetryAllowed": false,
    "sideDailyCoverageFailFast": true,
    "intradayD0CloseCoverageFailFast": true,
    "oosPerformanceResortAllowed": false,
    "fallbackAllowed": false
  }
}
