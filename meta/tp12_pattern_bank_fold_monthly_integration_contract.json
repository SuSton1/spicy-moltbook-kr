  "goal": {
    "targetPct": 0.12,
    "holdDays": 3,
    "entryRule": "NEXT_DAY_OPEN",
    "finalTarget": "Combine multiple train-period year2hit patterns so every explicit full month has at least five operational TP12 recommendations and five operational hits before locked future evaluation."
  },
  "dateRanges": {
