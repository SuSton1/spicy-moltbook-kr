    "maxOperationalMissRows": 0,
    "maxNonExecutableRows": 0,
    "requireMonthlyCoveragePassed": true,
    "requireMonthlyQuotaPassedWhenProvided": true,
    "failOnGateFailure": true
  },
  "hardStops": [
    "OOS or 2025-01-02-or-later data must not enter this integration gate.",
    "The final selected pattern set must be a subset of non-hit-purged patterns and fold-stable patterns.",
    "Monthly coverage is checked per explicit full month, never by average.",
    "Operational misses and non-executable recommendations are failures, not rows to delete.",
    "If the monthly five-hit target cannot be met, fail instead of relaxing thresholds."
  ]
