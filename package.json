{
  "name": "stockdesk-reset",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "DATA_MODE=${DATA_MODE:-kis} VITE_DATA_MODE=${VITE_DATA_MODE:-kis} vite",
    "dev:fixture": "DATA_MODE=fixture VITE_DATA_MODE=fixture vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "symbols:update": "node scripts/update-symbols.mjs",
    "symbols:update:us": "node scripts/update-us-symbols.mjs",
    "e2e:contract": "E2E_DATA_MODE=contract npx playwright test -g \"contract\"",
    "e2e:fixture": "E2E_DATA_MODE=fixture npx playwright test -g \"contract\"",
    "e2e:kis": "E2E_DATA_MODE=kis E2E_SYMBOL_KR=005930 npx playwright test -g \"kis\"",
    "e2e:all": "npm run e2e:contract && npm run e2e:kis",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "lightweight-charts": "^4.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "react-window": "^2.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "iconv-lite": "^0.7.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.16",
    "yauzl": "^2.10.0"
  }
}
